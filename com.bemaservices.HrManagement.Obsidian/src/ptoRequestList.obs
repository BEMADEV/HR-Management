<template>
    <Grid :data="gridDataSource"
          keyField="idKey"
          itemTerm="PTO Request"
          entityTypeGuid="f38b7ba2-1289-4cfe-afd4-74df942280d8"
          stickyHeader
          liveUpdates
          :onAddItem="config.isAddEnabled ? onAddItem : undefined"
          @selectItem="onSelectItem">

        <TextColumn name="person"
                    title="Person"
                    field="person"
                    :filter="textValueFilter"
                    visiblePriority="xs" />

        <TextColumn name="ptoType"
                    title="PTO Type"
                    field="ptoType"
                    :filter="textValueFilter"
                    visiblePriority="xs" />

        <TextColumn name="reason"
                    title="Reason"
                    field="reason"
                    :filter="textValueFilter"
                    visiblePriority="md" />

        <NumberColumn name="hours"
                       title="Total Hours"
                       field="hours"
                       :filter="numberValueFilter"
                       visiblePriority="xs" />

        <DateColumn name="requestDate"
                    title="Request Date"
                    field="requestDate"
                    :filter="dateValueFilter"
                    visiblePriority="xs" />

        <LabelColumn name="ptoRequestApprovalState"
                     title="Status"
                     field="ptoRequestApprovalState"
                     :filter="pickExistingValueFilter"
                     :classSource="{ Approved: 'success', Pending: 'warning', Denied: 'danger', Cancelled: 'default' }"
                     visiblePriority="xs" />

        <DeleteColumn v-if="config.isDeleteEnabled" @click="onDeleteClick" :disableConfirmation="true" />
    </Grid>
</template>

<script setup lang="ts">
import { onConfigurationValuesChanged, useConfigurationValues, useInvokeBlockAction, useReloadBlock } from "@Obsidian/Utility/block";
import Grid, { DateColumn, dateValueFilter, LabelColumn, NumberColumn, numberValueFilter, pickExistingValueFilter, TextColumn, textValueFilter, DeleteColumn } from "@Obsidian/Controls/grid";
import { ListBlockBox } from "@Obsidian/ViewModels/Blocks/listBlockBox";
import { PtoRequestListOptionsBag } from "./viewModels";
import { GridDataBag } from "@Obsidian/ViewModels/Core/Grid/gridDataBag";
import { NavigationUrlKey } from "./PtoRequestList/types.partial";
import { reactive, ref } from "vue";

const config = useConfigurationValues<ListBlockBox<PtoRequestListOptionsBag>>();
const invokeBlockAction = useInvokeBlockAction();

// All blocks auto reload when changing block settings
onConfigurationValuesChanged(useReloadBlock());

// #region Values

const gridDataSource = ref<Promise<GridDataBag>>();
let gridData: GridDataBag | undefined;

// #endregion

// #region Functions

/**
 * Called when the grid is requesting the row data be loaded.
 */
async function loadGridData(): Promise<GridDataBag> {
    const result = await invokeBlockAction<GridDataBag>("GetGridData");

    if (result.isSuccess && result.data) {
        gridData = reactive(result.data);
        return gridData;
    }
    else {
        throw new Error(result.errorMessage ?? "Unknown error while trying to load grid data.");
    }
}

// #endregion

// #region Event Handlers

/**
 * Called when a row has been selected by the individual.
 *
 * @param key The key of the row that was selected.
 */
function onSelectItem(key: string): void {
    if (config.navigationUrls?.[NavigationUrlKey.WorkflowEntryPage] && gridData?.rows) {
        const row = gridData.rows.find(r => r["idKey"] === key);
        if (row) {
            const guid = row["guid"];
            window.location.href = `${config.navigationUrls[NavigationUrlKey.WorkflowEntryPage]}?PTORequest=${guid}`;
        }
    }
}

/**
 * Called when the Add button has been clicked by the individual.
 */
function onAddItem(): void {
    if (config.navigationUrls?.[NavigationUrlKey.WorkflowEntryPage]) {
        let url = config.navigationUrls[NavigationUrlKey.WorkflowEntryPage];
        if (config.options?.contextPersonAliasGuid) {
            // If we have a person context, pass the person's primary alias guid.
            url += `?Person=${config.options.contextPersonAliasGuid}`;
        }
        window.location.href = url;
    }
}

/**
 * Called when the delete button is clicked for a row.
 */
async function onDeleteClick(key: string): Promise<void> {
    if (config.navigationUrls?.[NavigationUrlKey.WorkflowEntryPage] && gridData?.rows) {
        const row = gridData.rows.find(r => r["idKey"] === key);
        if (row) {
            const guid = row["guid"];
            window.location.href = `${config.navigationUrls[NavigationUrlKey.WorkflowEntryPage]}?PTORequest=${guid}&CancelRequest=Yes`;
        }
    }
}

// #endregion

// Load initial data
gridDataSource.value = loadGridData();
</script>
