# HR Management E2E Test Environment Configuration
# Copy this file to .env and update with your local Rock instance details

# Base URL of your Rock instance
ROCK_BASE_URL=http://localhost:6229

# Admin credentials for authentication tests
ROCK_ADMIN_USERNAME=admin
ROCK_ADMIN_PASSWORD=admin

# HR Management page URLs (relative to base URL)
HR_MANAGEMENT_PAGE=/page/123
PTO_TYPES_PAGE=/page/124
PTO_ALLOCATIONS_PAGE=/page/125
PTO_BRACKETS_PAGE=/page/126
PTO_TIERS_PAGE=/page/127
